# Razorpay: Dashboard → Account & Settings → API Keys (Test mode). Key ID and secret from the same page, no quotes.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe: Dashboard → Developers → API keys (test publishable + secret from the same account)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Optional, default 8787 (must match the proxy in vite.config.ts)
# PORT=8787
